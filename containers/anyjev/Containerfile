# AnyJev L0/L1 Stage-1 Choice — Grace Blackwell ARM64
# Replace sidecar scoring with anyjev+vLLM when ANYJEV_WEIGHTS are mounted.
FROM --platform=linux/arm64 python:3.12-slim-bookworm

ENV NVIDIA_VISIBLE_DEVICES=all \
    SYSTEMONE_PORT=8000 \
    SYSTEMONE_ENGINE_ID=anyjev-l0 \
    SYSTEMONE_FAMILY=anyjev \
    SYSTEMONE_MODEL_REVISION=anyjev-l0

WORKDIR /app
COPY systemone_sidecar.py /app/systemone_sidecar.py
EXPOSE 8000
CMD ["python", "/app/systemone_sidecar.py"]
