# CLM-8B Action Cache / Score — Grace Blackwell ARM64
# Production: clm-serve + `vllm serve … --runner pooling` with CLM8B_WEIGHTS.
FROM --platform=linux/arm64 python:3.12-slim-bookworm

ENV NVIDIA_VISIBLE_DEVICES=all \
    SYSTEMONE_PORT=8001 \
    SYSTEMONE_ENGINE_ID=clm-8b \
    SYSTEMONE_FAMILY=clm \
    SYSTEMONE_MODEL_REVISION=clm-8b

WORKDIR /app
COPY systemone_sidecar.py /app/systemone_sidecar.py
EXPOSE 8001
CMD ["python", "/app/systemone_sidecar.py"]
