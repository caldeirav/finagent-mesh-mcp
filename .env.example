# FinAgentBench — production / real models
# Point this at the official FinAgentBench dump (JSON/JSONL with stage1_labels,
# stage2_labels, chunks). Do NOT use the tiny repo sample for publishable runs.
FINAGENTBENCH_PATH=./data/finagentbench
EVAL_LEDGER_PATH=./eval_ledger.db

SYSTEMONE_STAGE1_URL=http://localhost:8000
SYSTEMONE_STAGE2_URL=http://localhost:8001
# Required for real-model claims
SYSTEMONE_MOCK=0
SYSTEMONE_BACKEND=real
# auto = CUDA if torch.cuda.is_available() else CPU
SYSTEMONE_DEVICE=auto
ENGINES_REGISTRY_PATH=./configs/engines.yaml
SYSTEMONE_SERVE_MODE=local

# Optional overrides (defaults are HF ids in configs/engines.yaml)
ANYJEV_WEIGHTS=vllm-sr/Decision-2.0-Lux-9B
CLM8B_WEIGHTS=Contrastive-LM/CLM-v0.1-8B
# Frozen CLM encoder (last-token pooling). Heads come from contrastive-lm.
CLM_ENCODER_ID=Qwen/Qwen3-8B
# Optional: vLLM pooling encoder instead of in-process Qwen3-8B
# CLM_EMB_URL=http://127.0.0.1:8090/v1/embeddings
DECISION20_KAI_WEIGHTS=vllm-sr/Decision-2.0-Kai-0.6B
DECISION20_LUX_WEIGHTS=vllm-sr/Decision-2.0-Lux-9B
LAYA_WEIGHTS=ameerhmz5/laya-modernbert-decision-90pct
AR_QWEN3_WEIGHTS=Qwen/Qwen3-8B
# Paper Block B dense IR (E5/GTE-class)
E5_WEIGHTS=intfloat/e5-base-v2
# Optional lux-clm-shortlist: BM25 top-K then CLM
CLM_SHORTLIST_K=32

# Kaggle API (required to download FinAgentBench competition data)
# https://www.kaggle.com/competitions/acm-icaif-25-ai-agentic-retrieval-grand-challenge/data
KAGGLE_USERNAME=
KAGGLE_KEY=

AGENT_GATEWAY_URL=http://localhost:8080
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SYNTHESIS_K=5
HARNESS_MAX_ATTEMPTS=3
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_ALLOW_FILE_STORE=true
PODMAN_OR_DOCKER=podman
