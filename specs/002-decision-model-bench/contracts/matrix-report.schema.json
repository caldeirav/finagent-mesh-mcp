{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finagent-mesh.local/schemas/matrix-report.json",
  "title": "DecisionModelMatrixReport",
  "type": "object",
  "required": [
    "matrix_run_id",
    "created_at",
    "dataset_path",
    "sample_seed",
    "sample_size",
    "selected_example_ids",
    "partners",
    "gemini_model",
    "systemone_mock",
    "synthesis_enabled",
    "rows"
  ],
  "properties": {
    "matrix_run_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "dataset_path": { "type": "string" },
    "sample_seed": { "type": ["integer", "null"] },
    "sample_size": { "type": ["integer", "null"] },
    "selected_example_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "partners": {
      "type": "object",
      "required": ["stage1_partner_id", "stage2_partner_id"],
      "properties": {
        "stage1_partner_id": { "type": "string" },
        "stage2_partner_id": { "type": "string" }
      }
    },
    "gemini_model": { "type": "string" },
    "systemone_mock": { "type": "boolean" },
    "synthesis_enabled": { "type": "boolean" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/MatrixRow" }
    }
  },
  "$defs": {
    "MatrixRow": {
      "type": "object",
      "required": [
        "variable_config_id",
        "eval_run_id",
        "stage1_engine_id",
        "stage2_engine_id",
        "status",
        "metrics"
      ],
      "properties": {
        "variable_config_id": { "type": "string" },
        "eval_run_id": { "type": "string" },
        "stage1_engine_id": { "type": "string" },
        "stage2_engine_id": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "running", "completed", "failed"]
        },
        "error": { "type": ["string", "null"] },
        "metrics": { "$ref": "#/$defs/EngineMetrics" }
      }
    },
    "EngineMetrics": {
      "type": "object",
      "required": ["n_examples"],
      "properties": {
        "stage1_ndcg_at_5": { "type": ["number", "null"] },
        "stage1_map_at_5": { "type": ["number", "null"] },
        "stage1_mrr_at_5": { "type": ["number", "null"] },
        "stage2_ndcg_at_5": { "type": ["number", "null"] },
        "stage2_map_at_5": { "type": ["number", "null"] },
        "stage2_mrr_at_5": { "type": ["number", "null"] },
        "latency_ms_p50": { "type": ["number", "null"] },
        "latency_ms_p95": { "type": ["number", "null"] },
        "parse_failure_rate": { "type": ["number", "null"] },
        "answer_normalized_em": { "type": ["number", "null"] },
        "answer_token_f1": { "type": ["number", "null"] },
        "n_examples": { "type": "integer", "minimum": 0 },
        "n_synthesis_attempted": { "type": "integer", "minimum": 0 },
        "n_synthesis_failed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
